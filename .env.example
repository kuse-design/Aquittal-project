# Copy to .env and fill in. Never commit the real .env.

# --- Database (PostgreSQL) ---
# Local:  postgresql://user:password@localhost:5432/storefront
# Render: injected automatically from the attached Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/storefront

# --- Auth ---
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Cloudinary (product images) ---
# Dashboard -> Account Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: SMTP order notifications ---
# Leave blank to disable emails; orders still appear in /admin/orders.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Server ---
PORT=3000
